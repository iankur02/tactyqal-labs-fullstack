{
  "info": {
    "name": "Tactyqal Labs API",
    "description": "Blog CMS + Auth API. Set `baseUrl`, `accessToken`, and `postId` collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "postId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "slug", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tactyqal.local\",\n  \"password\": \"ChangeMe_StrongPass123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Posts (Public)",
      "item": [
        {
          "name": "List published posts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/posts?page=1&limit=10&sort=newest"
          }
        },
        {
          "name": "Get by slug",
          "request": { "method": "GET", "url": "{{baseUrl}}/posts/slug/{{slug}}" }
        }
      ]
    },
    {
      "name": "Posts (Admin)",
      "item": [
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/posts/stats"
          }
        },
        {
          "name": "List (all)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/posts/admin?status=all&page=1&limit=10"
          }
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"How to launch your app in 30 days\",\n  \"excerpt\": \"A practical guide from Tactyqal Labs mentors.\",\n  \"content\": \"<p>Start with the problem...</p>\",\n  \"category\": \"{{categoryId}}\",\n  \"tags\": [\"launch\", \"mvp\"],\n  \"status\": \"draft\",\n  \"seoTitle\": \"Launch your app in 30 days\",\n  \"seoDescription\": \"A step-by-step founder playbook.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?._id) { pm.collectionVariables.set('postId', json.data._id); pm.collectionVariables.set('slug', json.data.slug); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        },
        {
          "name": "Update post",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"How to launch your app in 30 days (updated)\",\n  \"status\": \"published\"\n}"
            }
          }
        },
        {
          "name": "Delete post",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/posts/{{postId}}"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/categories",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Growth\",\n  \"description\": \"Growth experiments and launch tactics.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?._id) pm.collectionVariables.set('categoryId', json.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/categories/{{categoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Growth experiments and launch tactics (v2).\"\n}"
            }
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        }
      ]
    },
    {
      "name": "Upload",
      "item": [
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    }
  ]
}