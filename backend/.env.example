# ── App ──
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ──
MONGODB_URI=mongodb://127.0.0.1:27017/tactyqal_labs

# ── Auth (use `openssl rand -hex 32` → 64 chars; min 32 required) ──
