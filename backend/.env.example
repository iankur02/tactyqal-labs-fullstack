JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-64-char-random-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate limiting ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

